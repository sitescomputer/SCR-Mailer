# Build SCR Mailer from this checkout, including its branded frontend and templates.
FROM node:22-bookworm AS builder
COPY --from=golang:1.26.1-bookworm /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"
ENV CGO_ENABLED=0
WORKDIR /src
COPY . .
ARG SCR_VERSION
RUN CYPRESS_INSTALL_BINARY=0 make dist BIN=/tmp/scr-mailer LISTMONK_VERSION="$SCR_VERSION"

FROM alpine:3.22
LABEL org.opencontainers.image.title="SCR Mailer" \
      org.opencontainers.image.vendor="Sites Computer Resources" \
      org.opencontainers.image.source="https://github.com/sitescomputer/SCR-Mailer" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
RUN apk --no-cache add ca-certificates tzdata shadow su-exec
WORKDIR /listmonk
COPY --from=builder /tmp/scr-mailer .
COPY config.toml.sample config.toml
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
EXPOSE 9000
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["./scr-mailer"]
